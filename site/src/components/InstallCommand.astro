<div class="command">
      <span class="prompt">$</span>
      <code>curl -fsSL https://github.com/mouizahmed/hutch/releases/latest/download/install.sh | sh</code>
      <button type="button" class="copy-button" aria-label="Copy install command">
        <svg class="copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg>
        <svg class="done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      </button>
    </div>
<script>
// Each copy button copies the command beside it; the page may show it more than once.
for (const button of document.querySelectorAll<HTMLButtonElement>('.command .copy-button')) {
  button.addEventListener('click', () => {
    const text = button.parentElement?.querySelector('code')?.textContent ?? '';
    navigator.clipboard.writeText(text).then(() => {
      button.classList.add('copied');
      setTimeout(() => button.classList.remove('copied'), 1500);
    }, () => {});
  });
}
</script>
