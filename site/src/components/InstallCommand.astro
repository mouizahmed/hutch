<div class="command">
      <span class="prompt">$</span>
      <code id="install">curl -fsSL https://github.com/x/hutch/releases/latest/download/install.sh | sh</code>
      <button type="button" id="copy" aria-label="Copy install command">
        <svg class="copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg>
        <svg class="done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      </button>
    </div>
<script is:inline>
const copy = document.getElementById('copy');
copy.addEventListener('click', () => {
  navigator.clipboard.writeText(document.getElementById('install').textContent).then(() => {
    copy.classList.add('copied');
    setTimeout(() => copy.classList.remove('copied'), 1500);
  }, () => {});
});
</script>
